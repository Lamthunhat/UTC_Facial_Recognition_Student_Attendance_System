{
  "name": "utc-face-attendance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @utc/web dev",
    "build": "pnpm --filter @utc/web build",
    "start": "pnpm --filter @utc/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @utc/web test:e2e",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @utc/database db:generate",
    "db:migrate": "pnpm --filter @utc/database db:migrate",
    "db:seed:demo": "pnpm --filter @utc/database db:seed:demo",
    "models:download": "tsx scripts/download-models.ts",
    "admin:create": "pnpm --filter @utc/backend admin:create"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "@types/node": "^20"
  }
}
