# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
models/
.pglite/
!.env.example
.env.staging

# Playwright / kết quả test cục bộ
test-results/
playwright-report/

# Cấu hình Claude Code riêng từng máy (skills dùng chung vẫn được commit)
.claude/settings.local.json
.local-storage/
# Dữ liệu đọc thẻ chép lúc build (scripts/card-assets.mjs)
card-assets/
# MediaPipe tự host (tải/chép lúc build: models:download, scripts/card-assets.mjs)
apps/web/public/mediapipe/

# fontconfig (sharp/Pango) trên Windows khi không có FONTCONFIG_FILE: cache mặc định tạo trong thư mục chạy
LOCAL_APPDATA_FONTCONFIG_CACHE/
