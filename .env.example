# Sao chép thành .env.local khi chạy cục bộ. Trên Vercel: Project → Settings → Environment Variables.
# Không bao giờ commit file .env thật.

# Database (Supabase Supavisor, transaction mode, port 6543)
# Chạy thử cục bộ không cần Docker/Supabase: DATABASE_URL=pglite:./.pglite (Postgres nhúng, tự migrate)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Storage (chỉ dùng ở server)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Ký phiên đăng nhập (≥ 32 ký tự ngẫu nhiên): openssl rand -base64 48
JWT_SECRET=
# HMAC mã SV trong nhật ký bảo mật (≥ 32 ký tự, KHÁC JWT_SECRET): openssl rand -base64 48
LOG_HMAC_SECRET=
# Số kết nối tối đa mỗi instance (mặc định 3)
# DB_POOL_MAX=3
# Bảo vệ cron
CRON_SECRET=
# Chỉ đặt ở Preview khi cần đo: bật POST /api/spike/face (kèm Authorization: Bearer $CRON_SECRET). KHÔNG đặt ở Production.
# SPIKE_ENABLED=1
# Chỉ máy cục bộ: cho bản build production (next start) chạy trên DATABASE_URL=pglite:. Vô tác dụng trên Vercel.
# ALLOW_LOCAL_PGLITE=1

# Dịch vụ ngoài — TUỲ CHỌN (chưa dùng ở US1/US6). Thiếu thì app vẫn chạy; tính năng cần khoá trả 503 NOT_CONFIGURED.
# GOONG_API_KEY: US2 (địa chỉ trên ảnh bằng chứng). ANTHROPIC_API_KEY: US7/US8 (trợ lý AI, trích xuất minh chứng).
GOONG_API_KEY=
ANTHROPIC_API_KEY=

# Model khuôn mặt
FACE_MODELS_DIR=models

# Ngưỡng (cosine similarity) — giá trị sơ bộ, hiệu chỉnh bằng scripts/calibrate.ts
CARD_REJECT_BELOW=0.35
CARD_ACCEPT_ABOVE=0.5
# DUPLICATE_ABOVE: chờ hiệu chỉnh T011 (bộ ảnh thử ≥ 20 người) — 0,45 là giá trị tạm
DUPLICATE_ABOVE=0.45
CHECKIN_MATCH_ABOVE=0.55
# Ngưỡng độ tin cậy trích xuất vắng phép (FR-103)
LEAVE_FIELD_CONFIDENCE=0.8
LEAVE_CHAT_APPROVAL_CONFIDENCE=0.85
